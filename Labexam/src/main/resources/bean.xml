<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">
    
    <bean id="cs" class="com.example.demo.customerService">
    <property name="i">
    <map>
    <entry key="Biriynai" value="1"></entry>
    <entry key="Dal" value="1"></entry>
    <entry key="rice" value="1"></entry>
    </map>
    </property>
    </bean>
   
   <bean id="std" class="com.example.demo.customer" >
   <property name="orderid" value="1011"></property>
   <property name="customername" value="Aswini"></property>
   <property name="amount" ref="cs"></property>
